# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# NEVER commit real secrets. In production set these in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Public application URL — used by the /qr page, public links and resume links.
# Local:      http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=

# Admin authentication (server-side only). Leave blank in this template.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Local development database (used only when the D1 variables are blank).
LOCAL_DB_PATH=database/local.db

# Cloudflare D1 (production). Required on Vercel. Blank for local SQLite.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
